{
  "manifest_version": 3,
  "name": "GitHub Copilot Persian RTL",
  "version": "1.0",
  "description": "افزونه کروم برای پشتیبانی از راست‌چین کردن خودکار متن فارسی در GitHub Copilot",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "tabs"
  ],
  "content_scripts": [
    {
      "matches": ["https://github.com/copilot*"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/icon16-inactive.png",
      "48": "images/icon48-inactive.png",
      "128": "images/icon128-inactive.png"
    }
  },
  "icons": {
    "16": "images/icon16-inactive.png",
    "48": "images/icon48-inactive.png",
    "128": "images/icon128-inactive.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
